rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             (request.auth.token.role == 'admin' ||
              request.auth.token.accessRole in ['admin', 'global_admin']);
    }

    function isActiveBranchMember(branchId) {
      return isSignedIn() &&
             request.auth.token.branchId == branchId &&
             (request.auth.token.membershipStatus == 'active' ||
              request.auth.token.isApproved == true);
    }

    function canManageBranch(branchId) {
      return isAdmin() ||
             (isSignedIn() &&
              request.auth.token.accessRole == 'branch_admin' &&
              request.auth.token.branchId == branchId) ||
             (isSignedIn() &&
              request.auth.token.accessRole == 'region_admin' &&
              request.auth.token.regionId != null &&
              firestore.get(/databases/(default)/documents/branches/$(branchId)).data.regionId == request.auth.token.regionId);
    }

    function isPdfUpload() {
      return request.resource != null &&
             request.resource.size < 50 * 1024 * 1024 &&
             request.resource.contentType == 'application/pdf';
    }

    function isAudioUpload() {
      return request.resource != null &&
             request.resource.size < 100 * 1024 * 1024 &&
             request.resource.contentType in [
               'audio/mpeg',
               'audio/mp4',
               'audio/aac',
               'audio/x-m4a'
             ];
    }

    // Word Cards images - public read
    match /wordCards/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Legacy flat newsletter images remain readable during migration but may
    // no longer be created. New files must use a branch-scoped path below.
    match /newsletters/{fileName} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /newsletters/{branchId}/{allPaths=**} {
      allow read: if isActiveBranchMember(branchId) || canManageBranch(branchId);
      allow write: if canManageBranch(branchId);
    }
    
    // Praises files - require auth to read
    match /praises/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Published resources point to public PDF download URLs from Firestore metadata.
    // Writes stay global-admin-only and are limited to PDF files.
    match /resources/{resourceId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isPdfUpload();
      allow delete: if isAdmin();
    }

    // Hymn audio is public alongside published Resources metadata. Only a
    // global/legacy admin can upload it, and arbitrary file types are denied.
    match /resources/{resourceId}/audio/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isAudioUpload();
      allow delete: if isAdmin();
    }
    
    // Legacy v1-v6 folders - read only (old data)
    match /v1/{allPaths=**} { allow read: if true; allow write: if false; }
    match /v2/{allPaths=**} { allow read: if true; allow write: if false; }
    match /v3/{allPaths=**} { allow read: if true; allow write: if false; }
    match /v4/{allPaths=**} { allow read: if true; allow write: if false; }
    match /v5/{allPaths=**} { allow read: if true; allow write: if false; }
    match /v6/{allPaths=**} { allow read: if true; allow write: if false; }
  }
}
